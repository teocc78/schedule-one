# Copy this file to .env.local and fill in your values. Never commit .env.local.

# Gemini API key (server-side only) — get yours at https://aistudio.google.com
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash when empty. Leave empty unless you need a specific model.
GEMINI_MODEL=

# UCSB Developer API (Academic Curriculums v3). Optional: without it the app
# uses the saved fixtures in data/ucsb-fixtures/. Server-side only.
UCSB_API_KEY=

# Feature flags
NEXT_PUBLIC_FEATURE_LIKELIHOOD=false
